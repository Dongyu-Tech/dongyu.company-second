---
import Layout from "../../../../../layouts/Layout.astro";
import { PRIVACY_LANGS } from "../../../../../data/privacy";
import {
  DELETE_ACCOUNT_PRODUCTS,
  SUPPORT_EMAIL,
} from "../../../../../data/deleteAccount";

/**
 * 各 App 的「刪除帳戶」說明頁 —— Google Play 商店資訊填的帳戶刪除網址。
 * 文案全部在 src/data/deleteAccount.ts(Google Play 的三項規定也記在那裡)。
 *
 * 產出路由:
 *   /products/<slug>/app/delete-account      中文
 *   /products/<slug>/app/delete-account/en   英文
 */
export function getStaticPaths() {
  return DELETE_ACCOUNT_PRODUCTS.flatMap((product) =>
    PRIVACY_LANGS.map((lang) => ({
      params: { product: product.slug, lang: lang.seg },
      props: { product, lang },
    })),
  );
}

const { product, lang } = Astro.props;
const isEn = lang.key === "en";
const copy = product.copy[lang.key];

const basePath = `/products/${product.slug}/app/delete-account`;
// 收件人、主旨、內文都預先填好,使用者按下按鈕直接寄出即可
const mailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(product.subject)}&body=${encodeURIComponent(copy.mailBody)}`;
---

<Layout title={copy.title} description={copy.description} lang={lang.htmlLang}>
  <article>
    <!-- ── 麵包屑 + 語言切換 ─────────────────────────────── -->
    <section class="border-b border-line">
      <div class="mx-auto max-w-3xl px-6 py-10 lg:py-14">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <a
            href={copy.back.href}
            class="text-sm font-medium text-muted transition-colors hover:text-orbit"
          >
            {copy.back.label}
          </a>

          <nav
            aria-label={isEn ? "Language" : "語言"}
            class="flex items-center gap-1 rounded-full border border-line bg-soft p-1"
          >
            {
              PRIVACY_LANGS.map((l) => {
                const href = l.seg ? `${basePath}/${l.seg}` : basePath;
                const current = l.key === lang.key;
                return (
                  <a
                    href={href}
                    hreflang={l.htmlLang}
                    aria-current={current ? "page" : undefined}
                    class:list={[
                      "rounded-full px-3.5 py-1.5 text-xs font-semibold transition-colors",
                      current
                        ? "bg-card text-ink shadow-sm ring-1 ring-line"
                        : "text-muted hover:text-orbit",
                    ]}
                  >
                    {l.label}
                  </a>
                );
              })
            }
          </nav>
        </div>

        <p
          class="mt-8 font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
        >
          {copy.eyebrow}
        </p>
        <h1 class="mt-3 font-display text-3xl font-bold text-ink lg:text-4xl">
          {copy.title}
        </h1>
        <p class="mt-2 text-sm text-faint">{copy.appLine}</p>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-6 py-12 lg:py-16">
      <p class="text-base leading-relaxed text-muted">{copy.intro}</p>

      <!-- ── 步驟 + 一鍵寄信 ───────────────────────────────── -->
      <section class="mt-10 rounded-2xl border border-line bg-soft p-6 lg:p-8">
        <h2 class="font-display text-xl font-bold text-ink">
          {copy.stepsTitle}
        </h2>

        <ol class="mt-6 space-y-5">
          {
            copy.steps.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-orbit text-sm font-semibold text-white">
                  {i + 1}
                </span>
                <div>
                  <p class="font-semibold text-ink">{step.title}</p>
                  {step.body && (
                    <p class="mt-1 text-sm leading-relaxed text-muted">
                      {step.body}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>

        <a
          href={mailto}
          class="mt-7 inline-flex items-center justify-center rounded-full bg-orbit px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          {copy.buttonLabel}
        </a>
      </section>

      <!-- ── 刪除哪些資料 ─────────────────────────────────── -->
      <section class="mt-12">
        <h2 class="font-display text-xl font-bold text-ink">
          {copy.deletedTitle}
        </h2>
        <p class="mt-2 text-sm text-muted">{copy.deletedIntro}</p>
        <ul class="mt-4 space-y-2">
          {
            copy.deleted.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-orbit" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ── 保留哪些資料 ─────────────────────────────────── -->
      <section class="mt-12">
        <h2 class="font-display text-xl font-bold text-ink">
          {copy.keptTitle}
        </h2>
        <dl class="mt-4 divide-y divide-line rounded-2xl border border-line">
          {
            copy.kept.map((item) => (
              <div class="px-5 py-4">
                <dt class="text-sm font-semibold text-ink">{item.title}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-muted">
                  {item.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- ── 本機資料 / 注意事項 ──────────────────────────── -->
      <section class="mt-12">
        <h2 class="font-display text-xl font-bold text-ink">
          {copy.localTitle}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{copy.localBody}</p>
      </section>

      <section class="mt-10 rounded-2xl border border-line bg-soft p-6">
        <h2 class="font-display text-base font-bold text-ink">
          {copy.noteTitle}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{copy.noteBody}</p>
      </section>

      {/* 譯護還沒有隱私權政策頁,沒有 privacy 就整段不顯示 */}
      {
        copy.privacy && (
          <p class="mt-10 text-sm text-faint">
            {copy.privacy.prefix}
            <a
              href={copy.privacy.href}
              class="font-medium text-orbit underline underline-offset-4"
            >
              {copy.privacy.label}
            </a>
            {isEn ? "." : "。"}
          </p>
        )
      }
    </div>
  </article>
</Layout>
