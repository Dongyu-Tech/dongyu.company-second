---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import TeamCard from "../components/TeamCard.astro";

const team = [
  {
    name: "葉承均",
    role: "CEO",
    en: "Founder",
    dept: "中原大學 機械系・產品設計/募資",
  },
  {
    name: "沈奕瑋",
    role: "CTO",
    en: "Co-founder",
    dept: "中原大學 資工系・演算法/韌體/App",
  },
  {
    name: "王宥媗",
    role: "CMO",
    en: "Marketing",
    dept: "英屬哥倫比亞大學 商學・行銷/通路合作",
  },
  {
    name: "曹亦霆",
    role: "研發工程師",
    en: "R&D Engineer",
    dept: "中原大學 資工系・PCB/硬體整合",
  },
  {
    name: "謝沅峰",
    role: "硬體工程師",
    en: "Hardware",
    dept: "淡江大學 電機系・電路設計/電源",
  },
  {
    name: "賴奕涵",
    role: "材料工程師",
    en: "Materials",
    dept: "中原大學 化工系・材料與可靠度",
  },
  {
    name: "張哲語",
    role: "公共事務專員",
    en: "Public Affairs",
    dept: "暨南大學 公共行政・長照政策/補助對接",
  },
  {
    name: "廖苡叡",
    role: "法務專員",
    en: "Legal",
    dept: "銘傳大學 法律系・專利/合約/法遵",
  },
];

const values = [
  {
    title: "軟硬整合",
    desc: "不只寫程式,也做硬體與工業設計。我們相信好的智慧產品來自軟體、硬體與資料的緊密結合。",
  },
  {
    title: "真正落地",
    desc: "從概念到原型,再到場域驗證。每個產品都以「能不能被真實使用」為標準,而非停留在 demo。",
  },
  {
    title: "以人為本",
    desc: "從長者的行動自主到訓練者的數據回饋,我們關心技術如何改善真實生活中的每個動作。",
  },
];
---

<Layout
  title="關於我們"
  description="動域科技 — 跨校跨領域團隊,從機械、資工、電機到商學與法律,致力於把創新構想轉化為可落地的智慧產品。"
>
  <!-- ── 標題區 ───────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <p
        class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
      >
        About us
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl leading-tight font-bold text-ink sm:text-5xl"
      >
        打造下一代<br /><span class="text-orbit">智慧產品體驗</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        動域科技股份有限公司(Dongyu Tech)是一支跨校跨領域團隊,
        成員橫跨機械、資訊工程、電機、化工、商學、公共行政與法律。
        我們以軟硬整合與 AI 為核心,專注於把好點子打造成能被真實使用的智慧產品。
      </p>
    </div>
  </section>

  <!-- ── 創辦人的話 ───────────────────────────────────────── -->
  <section class="border-b border-line bg-soft">
    <div class="mx-auto max-w-3xl px-6 py-20 lg:py-28">
      <p
        class="reveal font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
      >
        Founder's note
      </p>
      <h2 class="reveal mt-3 text-3xl font-bold text-ink sm:text-4xl">
        創辦人的話
      </h2>
      <div
        class="reveal mt-8 space-y-5 text-base leading-relaxed text-muted lg:text-lg"
      >
        <p>
          動域科技的起點,不是一份商業計畫書,而是一個我改不掉的習慣:看到生活裡不對勁的地方,腦中就會自動冒出「它應該要長這樣」的畫面
          —
          健身房裡拆不完的槓片、長輩鞋裡藏著的退化訊號、隔著語言照顧同一位家人的看護與家庭。這些畫面不趕走我,就只好把它們做出來。動域存在的理由很簡單:<strong
            class="font-semibold text-ink"
            >把腦中的想法,一個一個變成真的東西。</strong
          >
        </p>
        <p>
          但我很清楚,想法只是起點。從「想到」到「做到」,中間隔著機構設計、電路、韌體、演算法、材料、法規、通路
          —
          沒有一個人跨得完這些領域。所以動域聚了一群不同背景的夥伴:有人畫電路、有人寫演算法、有人跑法規、有人對接政策。想法可以從一個人開始,產品卻從來不是一個人做得完的
          — 這家公司真正的產品,是「想到」和「做到」之間那條被縮到最短的路。
        </p>
        <p>
          我們不追風口,也不急著把自己定義成某一種公司。我只在意一件事:每個從動域出去的東西,都要真的能被使用
          — 被握在手裡、穿在腳上、天天打開。這就是我們說的,<strong
            class="font-semibold text-ink">讓創新,進入生活軌道。</strong
          >
        </p>
      </div>
      <div class="reveal mt-10">
        <p class="font-display text-lg font-bold text-ink">葉承均</p>
        <p class="mt-1 text-sm text-muted">動域科技 創辦人</p>
      </div>
    </div>
  </section>

  <!-- ── 我們的故事 ───────────────────────────────────────── -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="reveal">
          <p
            class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
          >
            Our story
          </p>
          <h2 class="mt-3 text-3xl leading-snug font-bold text-ink sm:text-4xl">
            從校園工作室,<br />做到真實場域
          </h2>
        </div>
        <div class="reveal space-y-5 text-base leading-relaxed text-muted">
          <p>
            動域科技從中原大學的學生團隊出發。我們沒有先寫好企劃書再找題目,而是反過來
            — 把每一場競賽都當成一次市場檢驗:累計參與超過 25
            場創新創業與設計競賽,從評審的追問和使用者的反應裡,把產品一次次改到能真正被使用。
          </p>
          <p>
            這條路讓我們拿到了發明專利、創業補助,也讓 SilverSole
            銀足從簡報上的概念,變成長照場域裡實際運作的裝置。
          </p>
          <p>
            2026 年,我們把戰場從簡報台搬進真實場域 —
            與洄瀾樂齡團隊合作的高齡科技巡迴賦能計畫奪下花蓮 HSH
            創新創業戰鬥營金獎,
            樂齡運動課程與步態量測,正一站一站走進花蓮的文健站。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 名字與標誌 ───────────────────────────────────────── -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 flex flex-col gap-3">
        <p
          class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
        >
          Name &amp; mark
        </p>
        <h2 class="text-3xl font-bold text-ink sm:text-4xl">名字與標誌</h2>
      </div>
      <div data-stagger class="grid gap-5 md:grid-cols-2">
        <div
          class="reveal rounded-2xl border border-line bg-card p-8 shadow-sm"
        >
          <h3 class="text-xl font-bold text-ink">「動域」— 動作的領域</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted lg:text-base">
            我們相信「動」是人最誠實的語言 — 步態、發力、平衡,
            身體的狀態都藏在每一個動作裡。動域科技做的事,
            就是用感測與演算法把這個領域打開,讓看不見的動作變成看得懂的資訊。
          </p>
        </div>
        <div
          class="reveal rounded-2xl border border-line bg-card p-8 shadow-sm"
        >
          <div class="flex items-center gap-4">
            <svg
              viewBox="0 0 128 128"
              width="44"
              height="44"
              role="img"
              aria-label="Orbit 標誌"
            >
              <g transform="translate(64 64)">
                <path
                  d="M 0 -56 A 56 56 0 1 1 -39.6 39.6"
                  fill="none"
                  stroke="#1A191D"
                  stroke-width="10"
                  stroke-linecap="round"></path>
                <circle cx="-39.6" cy="39.6" r="11" fill="#D9472B"></circle>
                <circle cx="0" cy="0" r="4" fill="#1A191D"></circle>
              </g>
            </svg>
            <h3 class="text-xl font-bold text-ink">Orbit — 進入生活軌道</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted lg:text-base">
            標誌是一顆沿著軌道繞行的行星。好的創新不該像流星劃過 —
            驚豔一下就消失;它該進入生活的軌道,天天被使用、安靜地運轉。
            這也是我們的一句話:<strong class="font-semibold text-ink"
              >讓創新,進入生活軌道。</strong
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 使命 / 價值 ──────────────────────────────────────── -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
    <div class="reveal mb-12 flex flex-col gap-3">
      <p
        class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
      >
        What we believe
      </p>
      <h2 class="text-3xl font-bold text-ink sm:text-4xl">我們相信的事</h2>
    </div>
    <div data-stagger class="grid gap-5 md:grid-cols-3">
      {
        values.map((v) => (
          <div class="reveal rounded-2xl border border-line bg-card p-7 transition duration-300 hover:-translate-y-1 hover:border-orbit/40">
            <div class="font-display text-2xl font-bold text-orbit">●</div>
            <h3 class="mt-4 text-xl font-bold text-ink">{v.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── 團隊 ─────────────────────────────────────────────── -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 flex flex-col gap-3">
        <p
          class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
        >
          Our team
        </p>
        <h2 class="text-3xl font-bold text-ink sm:text-4xl">創辦團隊</h2>
        <p class="max-w-xl text-muted">
          從機械、資工、電機、化工,到商學、公共行政與法律 —
          跨校跨領域的夥伴,組成能把產品從設計做到落地的一條龍團隊。
        </p>
      </div>

      <div data-stagger class="grid gap-5 sm:grid-cols-2">
        {team.map((m) => <TeamCard class="reveal" {...m} />)}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────── -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 text-center lg:px-10">
      <h2 class="text-3xl font-bold text-ink sm:text-4xl">
        想了解我們在做什麼?
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href="/products">查看產品</Button>
        <Button href="/contact" variant="outline">聯絡我們</Button>
      </div>
    </div>
  </section>
</Layout>
