---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

// 四項產品皆為開發中/驗證中,狀態一律寫進 desc 誠實呈現,不用標籤
const products = [
  {
    slug: "silversole",
    name: "SilverSole 銀足",
    en: "Smart Insole",
    tagline: "延青春 — 延長行動自主歲月",
    image: "/products/silversole-product.webp",
    imageW: 1254,
    imageH: 1254,
    imageAlt: "SilverSole 銀足智慧鞋墊產品圖:包裝、頂視、側視與後視",
    desc: "把足壓健檢與步態分析放進一雙鞋墊。長輩照常走路,行動力的變化就被看見 — 結合慣性與壓力感測,為高齡生活設計的主動健康管理。目前正於長照場域驗證中。",
    features: [
      {
        t: "足壓健檢 × 步態分析",
        d: "步速、節奏與左右對稱性長期追蹤,行動力變化提早被看見。",
      },
      {
        t: "跌倒風險提示",
        d: "多重感測條件綜合判定異常,第一時間主動通知家人與照護者。",
      },
      {
        t: "Step-to-Wake 自動喚醒",
        d: "踩踏即喚醒的省電設計,整體系統發明專利申請中。",
      },
      { t: "無感穿戴", d: "感測模組隱形嵌入鞋墊,可拆洗抗菌布套與防水設計。" },
    ],
    tags: ["發明專利申請中", "足壓健檢", "步態分析", "高齡照護"],
  },
  {
    slug: "quickplate",
    name: "QuickPlate 智慧槓片",
    en: "Smart Weight Plate",
    tagline: "側開秒拆 — 一片即槓、啞、鈴、輪",
    image: "/products/quickplate-render.webp",
    imageW: 1920,
    imageH: 1080,
    imageAlt: "QuickPlate 智慧槓片 3D 渲染圖:側開式扣合機構展示",
    desc: "智慧健身槓片系統,以已取得中華民國發明專利的「扣合式槓片結構」(I900457)為核心。獨家側開機構讓你免卸安全扣、從側邊秒級抽換重量;一組槓片更能變形為槓鈴、啞鈴、壺鈴與健腹輪。目前機構設計完成,產品化開發中。",
    features: [
      {
        t: "側開式扣合機構",
        d: "免卸安全扣、側邊秒級換重,核心發明專利 I900457(已核准)。",
      },
      {
        t: "一機多用變形",
        d: "一組槓片變形為槓鈴、啞鈴、壺鈴、健腹輪,極致空間坪效。",
      },
      {
        t: "QuickLog App(規劃中)",
        d: "NFC 靠近即辨識、IMU 自動計次與 VBT 速度分析,介面設計完成。",
      },
      {
        t: "數位捕手(規劃中)",
        d: "偵測單人力竭受困風險,主動發出警示與求救通知。",
      },
    ],
    tags: ["發明專利 I900457", "側開式扣合機構", "QuickLog App", "運動科技"],
  },
  {
    slug: "bridgemate",
    name: "橋伴 BridgeMate",
    en: "BridgeMate",
    tagline: "讓每一份工作都有尊嚴。",
    desc: "為聘僱移工的企業而生的管理平台。聘僱許可、居留證、健檢的到期日,常分散在紙本和不同的 Excel 裡,漏掉一張就可能面臨罰則 — 而市面上的人資系統多半只管本國勞工。橋伴把這些管起來。產品原型已可線上試用,正進行企業需求調查。",
    features: [
      {
        t: "證件期限管理",
        d: "聘僱許可、居留證、健檢到期前主動提醒,不再漏辦。",
      },
      {
        t: "出缺勤與薪資紀錄",
        d: "薪資明細同時有中文與移工母語版本,減少爭議。",
      },
      {
        t: "多語合約與公告",
        d: "重要文件與公告多語呈現,不因語言落差各說各話。",
      },
      { t: "雙語即時翻譯訊息", d: "你打中文、移工看母語,對話自動留存。" },
    ],
    tags: ["企業移工管理", "多語介面", "原型可試用"],
  },
  {
    slug: "easycare",
    name: "譯護 EasyCare",
    en: "EasyCare",
    tagline: "讓雇主與外籍看護,第一次真正聽懂彼此。",
    image: "/products/easycare-chat.webp",
    imageW: 410,
    imageH: 870,
    imageAlt: "譯護 App 原型:雇主與外籍看護的雙向即時翻譯對話畫面",
    imageNarrow: true,
    desc: "面向家庭看護場景的雙向溝通與照護管理平台,以 B2B2C 模式與人力仲介合作。產品定義、市場與法規查證完成,展示原型可實際操作,正進行驗證與洽談。",
    features: [
      { t: "雙向即時翻譯", d: "中文、印尼文、越南文即時互譯,對話自動留存。" },
      { t: "三端介面", d: "看護端、雇主家庭端、仲介端,各自看見需要的資訊。" },
      { t: "照護情境包", d: "長輩與嬰幼兒的常用照護情境,溝通句句到位。" },
      { t: "一鍵求助", d: "緊急狀況長按即發送求助,通知不漏接。" },
    ],
    tags: ["外籍看護溝通", "B2B2C", "中/印尼/越南文"],
  },
];
---

<Layout
  title="產品"
  description="動域科技的產品:SilverSole 銀足智慧鞋墊、QuickPlate 智慧槓片、橋伴 BridgeMate 企業移工管理平台、譯護 EasyCare 看護溝通平台。"
>
  <!-- ── 標題 ─────────────────────────────────────────────── -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
      <p
        class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
      >
        Products
      </p>
      <h1 class="mt-4 text-4xl leading-tight font-bold text-ink sm:text-5xl">
        把真實的問題，<span class="text-orbit">做成用得上的產品</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        從高齡照護、運動科技到移工溝通 — 每一項產品都誠實標示現在的階段,
        共同點是:用軟硬整合與軟體工程,解決真實場域裡的問題。
      </p>
    </div>
  </section>

  <!-- ── 產品詳細 ─────────────────────────────────────────── -->
  {
    products.map((p, i) => (
      <section id={p.slug} class="border-b border-line">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
          <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
            {/* 左:產品圖 + 文字 */}
            <div class="reveal">
              {p.image && (
                <img
                  src={p.image}
                  alt={p.imageAlt}
                  width={p.imageW}
                  height={p.imageH}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    "mb-8 rounded-2xl",
                    p.imageNarrow
                      ? "mx-auto w-full max-w-[280px]"
                      : "w-full border border-line shadow-sm",
                  ]}
                />
              )}
              <p class="font-display text-xs font-semibold tracking-[0.2em] text-orbit uppercase">
                {p.en}
              </p>
              <h2 class="mt-3 text-3xl font-bold text-ink lg:text-4xl">
                {p.name}
              </h2>
              <p class="mt-2 text-lg font-medium text-orbit/90">{p.tagline}</p>
              <p class="mt-5 text-sm leading-relaxed text-muted lg:text-base">
                {p.desc}
              </p>

              <ul class="mt-7 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <li class="rounded-full bg-soft px-3 py-1 text-xs text-muted ring-1 ring-line">
                    {t}
                  </li>
                ))}
              </ul>

              <div class="mt-8">
                <a
                  href={`/products/${p.slug}`}
                  class="group inline-flex items-center gap-2.5 rounded-full bg-orbit px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-orbit-bright hover:shadow-lg hover:shadow-orbit/25"
                >
                  完整介紹
                </a>
              </div>
            </div>

            {/* 右:特色清單 */}
            <div class="relative">
              <ul data-stagger class="relative space-y-4">
                {p.features.map((f) => (
                  <li class="reveal flex gap-4 rounded-2xl border border-line bg-card p-5 transition duration-300 hover:-translate-y-0.5 hover:border-orbit/30">
                    <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-orbit" />
                    <div>
                      <h3 class="font-bold text-ink">{f.t}</h3>
                      <p class="mt-1 text-sm leading-relaxed text-muted">
                        {f.d}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ── 法規說明 ─────────────────────────────────────────── -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-6 py-10 lg:px-10">
      <p class="text-xs leading-relaxed text-faint">
        ※
        本網站產品資訊僅供參考,各產品均為開發或驗證階段,尚未公開販售。SilverSole
        銀足現階段為消費級智慧裝置,非醫療器材,不提供診斷、治療或處方用途。
      </p>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────── -->
  <section>
    <div class="mx-auto max-w-7xl px-6 py-20 text-center lg:px-10">
      <h2 class="text-3xl font-bold text-ink sm:text-4xl">
        想了解技術細節或合作?
      </h2>
      <div class="mt-8 flex justify-center">
        <Button href="/contact">與我們聯絡</Button>
      </div>
    </div>
  </section>
</Layout>
