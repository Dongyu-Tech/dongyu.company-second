---
/**
 * SilverSole 銀足 App「傳連結給朋友」的落地頁:https://dongyu.company/f/?t=<token>
 *
 * - 手機有裝 App:Android App Links / iOS Universal Links 會直接打開 App,
 *   根本不會看到這頁(要靠 public/.well-known/ 底下的兩個檔)。
 * - LINE、Facebook 的內建瀏覽器不會把連結交給 App,這時會看到這頁:
 *   「用銀足 App 打開」改用 intent://(Android)或 silversole://(iOS)。
 * - 沒裝 App:兩個商店下載鈕;裝好之後回來再點一次連結(沒有自動帶過去)。
 *
 * 這頁不連任何後端、不顯示是誰分享的:token 只在網址裡,由 App 去查。
 * 網址 /f/、參數 t,以及 .well-known 的兩個檔都寫死在 App 裡
 * (silversole-app lib/core/friends/friend_rules.dart),改了連結就會失效。
 */
import Layout from "../../layouts/Layout.astro";

const PLAY_URL =
  "https://play.google.com/store/apps/details?id=com.dongyutech.silversole";
// App Store 正在審核中,上架後把網址填進來(例如 https://apps.apple.com/tw/app/…/id…)。
const APP_STORE_URL = "";
---

<Layout
  title="加好友"
  description="朋友傳了銀足 SilverSole 的加好友連結給你。"
  noindex
>
  <section class="mx-auto max-w-xl px-6 py-12 text-ink">
    <p
      class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
    >
      SilverSole 銀足
    </p>
    <h1 class="mt-4 text-3xl leading-snug font-bold sm:text-4xl">
      朋友想跟你在銀足當好友
    </h1>
    <p class="mt-4 text-xl leading-relaxed text-muted">
      打開銀足 App,就會看到是誰。按「加他當朋友」,等他同意就成為好友了。
    </p>

    <!-- 有裝 App -->
    <div class="mt-10 rounded-2xl border border-line bg-card p-6">
      <h2 class="text-2xl font-bold">已經有銀足 App</h2>
      <a
        id="open-app"
        href="#"
        class="mt-5 flex min-h-16 w-full items-center justify-center rounded-full bg-orbit px-6 text-xl font-semibold text-white transition-colors hover:bg-orbit-bright"
      >
        用銀足 App 打開
      </a>
      <p id="bad-link" class="mt-4 hidden text-xl leading-relaxed text-muted">
        這個連結不完整,請朋友在銀足 App 裡再傳一次。
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        在 LINE 裡按了沒反應:點右上角的「⋯」,選「用預設瀏覽器開啟」,再按一次。
      </p>
    </div>

    <!-- 沒裝 App -->
    <div class="mt-6 rounded-2xl border border-line bg-card p-6">
      <h2 class="text-2xl font-bold">還沒有銀足 App</h2>
      <p class="mt-3 text-xl leading-relaxed text-muted">
        先下載,裝好之後回來再點一次朋友傳的連結。
      </p>
      <div class="mt-5 flex flex-col gap-4">
        <a
          href={PLAY_URL}
          rel="noopener noreferrer"
          class="flex min-h-16 w-full items-center justify-center rounded-full border border-line px-6 text-center text-xl font-semibold text-ink transition-colors hover:border-orbit hover:text-orbit"
        >
          Google Play 下載(Android)
        </a>
        {
          APP_STORE_URL ? (
            <a
              href={APP_STORE_URL}
              rel="noopener noreferrer"
              class="flex min-h-16 w-full items-center justify-center rounded-full border border-line px-6 text-center text-xl font-semibold text-ink transition-colors hover:border-orbit hover:text-orbit"
            >
              App Store 下載(iPhone)
            </a>
          ) : (
            <p class="flex min-h-16 w-full items-center justify-center rounded-full border border-dashed border-line px-6 text-center text-xl text-muted">
              App Store(iPhone)審核中,即將上架
            </p>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ PLAY_URL }}>
  // 「用銀足 App 打開」:從網址讀 t(32 位十六進位),組成 App 認得的網址。
  // Android 用 intent://,沒裝 App 時 Chrome 直接帶去 Google Play;
  // 其他(iPhone)用 silversole://。token 不對就把按鈕藏起來。
  function setupOpenApp() {
    const button = document.getElementById("open-app");
    const bad = document.getElementById("bad-link");
    if (!button || !bad) return;
    const token = (new URLSearchParams(location.search).get("t") || "")
      .trim()
      .toLowerCase();
    if (!/^[0-9a-f]{32}$/.test(token)) {
      button.classList.add("hidden");
      bad.classList.remove("hidden");
      return;
    }
    const path = "dongyu.company/f/?t=" + token;
    const android = /android/i.test(navigator.userAgent);
    button.setAttribute(
      "href",
      android
        ? "intent://" +
            path +
            "#Intent;scheme=silversole;package=com.dongyutech.silversole;S.browser_fallback_url=" +
            encodeURIComponent(PLAY_URL) +
            ";end"
        : "silversole://" + path,
    );
  }
  document.addEventListener("astro:page-load", setupOpenApp);
</script>
