---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ServiceCard from "../components/ServiceCard.astro";
import NewsCard from "../components/NewsCard.astro";

// 最新消息:取最近 4 則
const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

// Hero 輪播圖:自託管 WebP(來源 Unsplash 免費授權,原始 ID 記於 public/hero/_來源.txt)
// srcset 讓手機抓小圖,壓 LCP
const heroImg = (name: string) => ({
  src: `/hero/${name}-1600.webp`,
  srcset: `/hero/${name}-800.webp 800w, /hero/${name}-1200.webp 1200w, /hero/${name}-1600.webp 1600w`,
});
const slides = [
  { ...heroImg("hero-aiot"), alt: "電路板特寫 — AIoT 軟硬整合" },
  { ...heroImg("hero-engineering"), alt: "工程師於產線工作 — 產品設計與製造" },
  { ...heroImg("hero-gym"), alt: "健身房訓練場景 — 運動科技" },
];
---

<Layout>
  <!-- ── Hero 輪播 ────────────────────────────────────────── -->
  <section id="hero" class="relative overflow-hidden bg-night">
    <!-- 背景輪播圖 -->
    <div class="absolute inset-0" aria-hidden="true">
      {
        slides.map((s, i) => (
          <div
            class:list={["hero-slide absolute inset-0", i === 0 && "is-active"]}
          >
            <img
              src={s.src}
              srcset={s.srcset}
              sizes="100vw"
              alt={s.alt}
              width="1600"
              height="900"
              class="h-full w-full object-cover"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding="async"
            />
          </div>
        ))
      }
      <!-- 深色遮罩:左重右輕,保文字對比 -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-night/90 via-night/60 to-night/30"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-night/70 to-transparent"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 py-28 lg:px-10 lg:py-40">
      <div class="max-w-3xl">
        <div class="rise-in flex items-center gap-3">
          <span class="h-px w-10 bg-orbit-bright"></span>
          <span class="text-sm font-medium tracking-wide text-paper-muted">
            動域科技 <span class="text-orbit-bright">Dongyu Tech</span>
          </span>
        </div>

        <h1
          class="rise-in mt-6 font-display text-5xl leading-[1.15] font-bold text-white sm:text-6xl lg:text-7xl"
          style="animation-delay:.05s"
        >
          讓創新構想，<br />
          <span class="text-orbit-bright">真正進入生活軌道。</span>
        </h1>

        <p
          class="rise-in mt-7 max-w-xl text-lg leading-relaxed text-paper-muted"
          style="animation-delay:.12s"
        >
          結合軟體、硬體與 AI 能力,<br class="hidden sm:block" />
          將創新構想轉化為真正可落地的產品與服務。
        </p>

        <div
          class="rise-in mt-10 flex flex-wrap gap-4"
          style="animation-delay:.18s"
        >
          <Button href="/products">查看產品</Button>
          <Button href="/about" variant="ghost-light">關於我們</Button>
        </div>
      </div>
    </div>

    <!-- 輪播圓點 -->
    <div
      id="hero-dots"
      class="absolute inset-x-0 bottom-6 z-10 flex items-center justify-center gap-2.5"
    >
      {
        slides.map((_, i) => (
          <button
            type="button"
            data-slide={i}
            aria-label={`切換到第 ${i + 1} 張`}
            class="flex h-11 w-11 items-center justify-center"
          >
            <span
              class:list={[
                "h-2.5 rounded-full transition-all duration-500",
                i === 0
                  ? "w-8 bg-orbit-bright"
                  : "w-2.5 bg-white/40 hover:bg-white/70",
              ]}
            />
          </button>
        ))
      }
    </div>
  </section>

  <!-- ── 服務領域 ─────────────────────────────────────────── -->
  <section id="services" class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
    <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-3">
        <p
          class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
        >
          What we do
        </p>
        <h2 class="text-3xl font-bold text-ink sm:text-4xl">三大核心能力</h2>
      </div>
      <a
        href="/technology"
        class="text-sm font-medium text-muted transition-colors hover:text-orbit"
      >
        深入了解核心技術
      </a>
    </div>

    <div data-stagger class="grid gap-5 md:grid-cols-3">
      <ServiceCard
        class="reveal"
        title="AIoT"
        en="AI · IoT"
        desc="感測器、低功耗韌體、演算法到雲端,一條鏈自己打通,不用跨廠商拼裝;讓感測訊號變成使用者看得懂的即時資訊。"
      >
        <svg
          class="h-9 w-9"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="4" width="16" height="16" rx="2"></rect>
          <rect x="9" y="9" width="6" height="6"></rect>
          <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"
          ></path>
        </svg>
      </ServiceCard>

      <ServiceCard
        class="reveal"
        title="產品設計"
        en="Product Design"
        desc="不只畫概念圖 — 從 3D 建模到 3D 列印,直接做出可商品化的硬體;列印對我們不只是打樣,更是量產方式。"
      >
        <svg
          class="h-9 w-9"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      </ServiceCard>

      <ServiceCard
        class="reveal"
        title="軟體工程"
        en="Software Engineering"
        desc="Web、App 與資料後台皆自行開發,把裝置蒐集到的數據,變成使用者一眼看懂的畫面。"
      >
        <svg
          class="h-9 w-9"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </ServiceCard>
    </div>
  </section>

  <!-- ── 產品預覽 ─────────────────────────────────────────── -->
  <section id="flagship" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-3">
          <p
            class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
          >
            Our products
          </p>
          <h2 class="text-3xl font-bold text-ink sm:text-4xl">商品</h2>
        </div>
        <a
          href="/products"
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-orbit"
        >
          查看全部
        </a>
      </div>

      <div data-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              slug: "silversole",
              en: "Smart Insole",
              name: "SilverSole 銀足",
              tagline: "延青春 — 延長行動自主歲月",
              desc: "足壓健檢 × 步態分析的智慧鞋墊,長輩照常走路,行動力變化就被看見。",
            },
            {
              slug: "quickplate",
              en: "Smart Weight Plate",
              name: "QuickPlate 智慧槓片",
              tagline: "側開秒拆 — 一片即槓、啞、鈴、輪",
              desc: "發明專利側開扣合,秒級換重,一組槓片變形為四種器材。",
            },
            {
              slug: "bridgemate",
              en: "BridgeMate",
              name: "橋伴",
              tagline: "讓每一份工作都有尊嚴。",
              desc: "為聘僱移工的企業管好證件期限、雙語薪資與即時翻譯訊息。",
            },
            {
              slug: "easycare",
              en: "EasyCare",
              name: "譯護",
              tagline: "讓雇主與外籍看護,真正聽懂彼此。",
              desc: "雙向即時翻譯 × 照護情境包,與人力仲介合作的溝通平台。",
            },
          ].map((p) => (
            <a
              href={`/products/${p.slug}`}
              class="group reveal flex h-full flex-col rounded-2xl border border-line bg-card p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orbit/40 hover:shadow-md"
            >
              <p class="font-display text-xs font-semibold tracking-[0.2em] text-orbit uppercase">
                {p.en}
              </p>
              <h3 class="mt-2 text-lg font-bold text-ink">{p.name}</h3>
              <p class="mt-1 text-sm font-medium text-orbit/90">{p.tagline}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
                {p.desc}
              </p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-orbit">
                完整介紹
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 最新消息 ─────────────────────────────────────────── -->
  <section id="news" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-3">
          <p
            class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
          >
            News
          </p>
          <h2 class="text-3xl font-bold text-ink sm:text-4xl">最新動態</h2>
        </div>
        <a
          href="/news"
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-orbit"
        >
          查看全部動態
        </a>
      </div>

      <div data-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          news.map((n) => (
            <NewsCard
              class="reveal"
              id={n.id}
              title={n.data.title}
              dateLabel={n.data.dateLabel}
              summary={n.data.summary}
              image={n.data.image}
              imageAlt={n.data.imageAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 落地實績 ─────────────────────────────────────────── -->
  <section id="cases" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-3">
          <p
            class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
          >
            Field work
          </p>
          <h2 class="text-3xl font-bold text-ink sm:text-4xl">落地實績</h2>
        </div>
        <a
          href="/huilan"
          class="group inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-orbit"
        >
          查看全部計畫
        </a>
      </div>

      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <!-- 左:案例說明 -->
        <div class="reveal">
          <p
            class="font-display text-xs font-semibold tracking-[0.2em] text-orbit uppercase"
          >
            洄瀾樂齡 × 動域科技
          </p>
          <h3 class="mt-3 text-2xl font-bold text-ink lg:text-3xl">
            高齡科技巡迴賦能計畫
          </h3>
          <p class="mt-5 text-sm leading-relaxed text-muted lg:text-base">
            以「長照活動旅行社」的概念,與洄瀾樂齡團隊合作,把樂齡運動課程與科學化的步態量測,
            巡迴帶進花蓮的文健站。動域科技擔任技術夥伴,提供 SilverSole
            銀足智慧鞋墊與數據平台,讓長輩的行動能力變化在課程前後看得見。
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="https://hlll.dongyu.company"
              target="_blank"
              rel="noopener"
              class="group inline-flex items-center gap-2.5 rounded-full bg-orbit px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-orbit-bright hover:shadow-lg hover:shadow-orbit/25"
            >
              前往計畫官網
            </a>
            <Button href="/contact" variant="outline">與我們討論落地計畫</Button
            >
          </div>
        </div>

        <!-- 右:合作內容 / 目前進展 -->
        <div data-stagger class="space-y-5">
          <div
            class="reveal rounded-2xl border border-line bg-card p-6 shadow-sm"
          >
            <h4 class="font-bold text-ink">合作內容</h4>
            <ul class="mt-4 space-y-3">
              {
                [
                  "SilverSole 銀足的足壓與步態量測,結合樂齡運動課程設計",
                  "巡迴文健站的行動化量測流程與器材規劃",
                  "量測數據的視覺化報表,課程前後的變化看得見",
                ].map((t) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted">
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-orbit" />
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
          <div
            class="reveal rounded-2xl border border-line bg-card p-6 shadow-sm"
          >
            <h4 class="font-bold text-ink">目前進展</h4>
            <ul class="mt-4 space-y-3">
              {
                [
                  "奪 2026 HSH 創新創業戰鬥營金獎,獲 80 萬元落地執行資源",
                  "計畫官網上線,對外開放合作洽詢",
                  "花蓮文健站巡迴場次規劃執行中",
                ].map((t) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-muted">
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-orbit" />
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 分眾 CTA ─────────────────────────────────────────── -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
      <div class="reveal mb-12 text-center">
        <p
          class="font-display text-sm font-semibold tracking-[0.2em] text-orbit uppercase"
        >
          Work with us
        </p>
        <h2 class="mt-3 text-3xl font-bold text-ink sm:text-4xl">
          下一步,看你是哪一種
        </h2>
      </div>

      <div data-stagger class="grid gap-6 md:grid-cols-2">
        <!-- 技術合作 -->
        <div
          class="reveal rounded-3xl border border-line bg-card p-8 shadow-sm lg:p-10"
        >
          <div class="relative">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-full bg-soft text-orbit ring-1 ring-line"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"
                ></path>
                <path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8"></path>
              </svg>
            </span>
            <h3 class="mt-5 text-xl font-bold text-ink">尋求技術合作</h3>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
              想找軟硬整合、AIoT
              或產品設計的開發夥伴?把你的構想或需求告訴我們,一起評估如何落地。
            </p>
            <div class="mt-7">
              <Button href="/contact">談談合作</Button>
            </div>
          </div>
        </div>

        <!-- 產品需求 -->
        <div
          class="reveal rounded-3xl border border-line bg-card p-8 shadow-sm lg:p-10"
        >
          <div class="relative">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-full bg-soft text-orbit ring-1 ring-line"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                ></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            <h3 class="mt-5 text-xl font-bold text-ink">了解我們的產品</h3>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
              對 SilverSole 銀足或 QuickPlate
              智慧槓片有興趣?看看產品細節,或直接與我們聯絡洽詢。
            </p>
            <div class="mt-7">
              <Button href="/products" variant="outline">查看產品</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hero 輪播:自動播放 + 圓點切換;hover 暫停;reduced-motion 不自動播
  function setupHeroCarousel() {
    const hero = document.getElementById("hero");
    if (!hero || hero.dataset.carouselReady) return;
    hero.dataset.carouselReady = "1";

    const slides = Array.from(
      hero.querySelectorAll<HTMLElement>(".hero-slide"),
    );
    const dots = Array.from(
      hero.querySelectorAll<HTMLButtonElement>("#hero-dots button"),
    );
    if (slides.length <= 1) return;

    let current = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    function show(idx: number) {
      current = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
      dots.forEach((d, i) => {
        const dot = d.firstElementChild as HTMLElement | null;
        if (!dot) return;
        dot.classList.toggle("w-8", i === current);
        dot.classList.toggle("bg-orbit-bright", i === current);
        dot.classList.toggle("w-2.5", i !== current);
        dot.classList.toggle("bg-white/40", i !== current);
      });
    }

    function play() {
      if (reduced || timer) return;
      timer = window.setInterval(() => show(current + 1), 6000);
    }
    function pause() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }

    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        show(i);
        pause();
        play();
      }),
    );
    hero.addEventListener("mouseenter", pause);
    hero.addEventListener("mouseleave", play);
    document.addEventListener("visibilitychange", () =>
      document.hidden ? pause() : play(),
    );

    play();
  }

  document.addEventListener("astro:page-load", setupHeroCarousel);
</script>
