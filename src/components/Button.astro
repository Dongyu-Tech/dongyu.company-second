---
interface Props {
  href: string;
  variant?: "primary" | "outline" | "ghost-light";
  class?: string;
}
const { href, variant = "primary", class: className = "" } = Astro.props;

const base =
  "group inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 text-sm font-semibold transition-all duration-300";
const styles = {
  primary:
    "bg-orbit text-white hover:bg-orbit-bright hover:shadow-lg hover:shadow-orbit/25",
  outline:
    "border border-line bg-card/60 text-ink hover:border-orbit hover:text-orbit",
  /* 深色照片上用的半透明白框按鈕(Hero 輪播) */
  "ghost-light":
    "border border-white/40 bg-white/10 text-white backdrop-blur-sm hover:border-white hover:bg-white/20",
};
---

<a href={href} class:list={[base, styles[variant], className]}>
  <slot />
</a>
