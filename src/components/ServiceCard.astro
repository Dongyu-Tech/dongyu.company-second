---
// 三大能力卡:icon 用 inline SVG(以 slot 傳入),文字 props
interface Props {
  title: string;
  en: string;
  desc: string;
  class?: string;
}
const { title, en, desc, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "rounded-2xl border border-line bg-card p-7 shadow-sm",
    className,
  ]}
>
  <div class="mb-5 text-orbit">
    <slot />
  </div>
  <p
    class="font-display text-xs font-medium tracking-[0.2em] text-faint uppercase"
  >
    {en}
  </p>
  <h3 class="mt-1 text-xl font-bold text-ink">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{desc}</p>
</div>
