---
import OrbitMark from "./OrbitMark.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "首頁" },
  { href: "/news", label: "最新動態" },
  { href: "/technology", label: "核心技術" },
  { href: "/products", label: "產品" },
  { href: "/huilan", label: "洄瀾樂齡" },
  { href: "/about", label: "關於動域" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line/80 bg-card/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10"
  >
    <a href="/" class="group flex items-center gap-3">
      <OrbitMark size={34} spin={true} />
      <span class="leading-tight">
        <span
          class="block font-display text-base font-bold tracking-tight text-ink"
        >
          Dongyu Tech
        </span>
        <span class="block text-[11px] tracking-[0.3em] text-muted">
          動域科技
        </span>
      </span>
    </a>

    <!-- 桌面導覽 -->
    <ul class="hidden items-center gap-5 md:flex lg:gap-7">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "relative text-sm font-medium whitespace-nowrap transition-colors hover:text-ink",
                isActive(l.href) ? "text-ink" : "text-muted",
              ]}
            >
              {l.label}
              {isActive(l.href) && (
                <span class="absolute -bottom-1.5 left-0 h-0.5 w-full bg-orbit" />
              )}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/contact"
          class="rounded-full bg-orbit px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-orbit-bright"
        >
          聯絡我們
        </a>
      </li>
    </ul>

    <!-- 行動裝置:漢堡按鈕 -->
    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="開啟選單"
      aria-expanded="false"
    >
      <span class="block h-0.5 w-6 bg-ink transition-transform"></span>
      <span class="block h-0.5 w-6 bg-ink transition-opacity"></span>
      <span class="block h-0.5 w-6 bg-ink transition-transform"></span>
    </button>
  </nav>

  <!-- 行動裝置選單:絕對定位浮在頁面內容上方(header sticky 是定位基準),
       展開時不擠壓版面 -->
  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full hidden max-h-[75vh] overflow-y-auto border-t border-line bg-card shadow-lg md:hidden"
  >
    <ul class="flex flex-col px-6 py-4">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "block py-3 text-base font-medium",
                isActive(l.href) ? "text-orbit" : "text-ink",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // 綁在 document 做事件委派:ClientRouter 換頁會整個換掉 header,
  // 綁在按鈕上的監聽會跟著失效,委派則不受 DOM 置換影響
  document.addEventListener("click", (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLElement>(
      "#menu-toggle",
    );
    if (!toggle) return;
    const menu = document.getElementById("mobile-menu");
    if (!menu) return;
    const isOpen = !menu.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "關閉選單" : "開啟選單");
  });
</script>
