---
interface Props {
  name: string;
  role: string;
  en: string;
  dept: string;
  class?: string;
}
const { name, role, en, dept, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-4 rounded-2xl border border-line bg-card p-5",
    className,
  ]}
>
  <div>
    <p
      class="font-display text-xs font-semibold tracking-[0.15em] text-orbit uppercase"
    >
      {role} · {en}
    </p>
    <h3 class="mt-0.5 text-lg font-bold text-ink">{name}</h3>
    <p class="text-sm text-muted">{dept}</p>
  </div>
</div>
