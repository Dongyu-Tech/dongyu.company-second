---
interface Props {
  name: string;
  role: string;
  en: string;
  dept: string;
  class?: string;
}
const { name, role, en, dept, class: className = '' } = Astro.props;
const initial = name.charAt(0);
---

<div
  class:list={[
    'group flex items-center gap-4 rounded-2xl border border-line bg-card p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orbit/40 hover:shadow-md',
    className,
  ]}
>
  <!-- 頭像佔位:Orbit 風格圓 + 首字 -->
  <div
    class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-soft ring-1 ring-line"
  >
    <span class="font-display text-lg font-bold text-ink">{initial}</span>
    <span
      class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full bg-orbit ring-2 ring-card transition-transform duration-300 group-hover:scale-125"
    ></span>
  </div>
  <div>
    <p class="font-display text-xs font-semibold uppercase tracking-[0.15em] text-orbit">
      {role} · {en}
    </p>
    <h3 class="mt-0.5 text-lg font-bold text-ink">{name}</h3>
    <p class="text-sm text-muted">{dept}</p>
  </div>
</div>
