---
// 消息卡:整張可點,連到 /news/<id> 內頁(仿新聞列表)
interface Props {
  id: string;
  title: string;
  dateLabel: string;
  summary: string;
  image?: string;
  imageAlt?: string;
  class?: string;
}
const {
  id,
  title,
  dateLabel,
  summary,
  image,
  imageAlt,
  class: className = "",
} = Astro.props;
---

<a
  href={`/news/${id}`}
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-card shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orbit/40 hover:shadow-md",
    className,
  ]}
>
  {
    image && (
      <img
        src={image}
        alt={imageAlt ?? title}
        loading="lazy"
        class="aspect-[16/10] w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <time class="font-display text-xs tracking-wide text-faint"
      >{dateLabel}</time
    >
    <h3 class="mt-4 text-base leading-snug font-bold text-ink">
      {title}
    </h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{summary}</p>
    <span class="mt-4 inline-flex items-center text-sm font-medium text-orbit">
      閱讀更多
    </span>
  </div>
</a>
